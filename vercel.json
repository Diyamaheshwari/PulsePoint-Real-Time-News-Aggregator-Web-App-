{
  "buildCommand": "cd pulsepoint/client && npm install && npm run build",
  "outputDirectory": "pulsepoint/client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
